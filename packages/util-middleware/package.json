{
  "name": "@smithy/util-middleware",
  "version": "4.5.0",
  "description": "Shared utilities for to be used in middleware packages.",
  "keywords": [
    "aws",
    "middleware"
  ],
  "homepage": "https://github.com/smithy-lang/smithy-typescript/tree/master/packages/util-middleware",
  "license": "Apache-2.0",
  "author": {
    "name": "AWS SDK for JavaScript Team",
    "url": "https://aws.amazon.com/sdk-for-javascript/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smithy-lang/smithy-typescript.git",
    "directory": "packages/util-middleware"
  },
  "files": [
    "dist-*/**"
  ],
  "sideEffects": false,
  "main": "./dist-cjs/index.js",
  "module": "./dist-es/index.js",
  "types": "./dist-types/index.d.ts",
  "scripts": {
    "build": "yarn g:tsc -p tsconfig.cjs.json && yarn g:tsc -p tsconfig.es.json && yarn g:tsc -p tsconfig.types.json",
    "build:types": "premove dist-types && yarn g:tsc -p tsconfig.types.json",
    "clean": "premove dist-cjs dist-es dist-types"
  },
  "dependencies": {
    "@smithy/core": "workspace:^",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "premove": "4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
