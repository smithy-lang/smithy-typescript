{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "turbo.jsonc",
    "tsconfig.json",
    "tsconfig.cjs.json",
    "tsconfig.es.json",
    "tsconfig.types.json",
    "scripts/compilation/**",
  ],
  "tasks": {
    "prebuild": {},
    "build": {
      "dependsOn": ["prebuild", "^build"],
      "inputs": ["src/**/*", "package.json"],
      "outputs": ["dist-types/**", "dist-cjs/**", "dist-es/**", "dist"],
    },
    "build:cjs": {
      "outputs": ["dist-cjs/**"],
      "dependsOn": ["build:es"],
    },
    "build:es": {
      // ^build:types is critical: without upstream .d.ts files, tsc cannot
      // distinguish type-only re-exports from values, causing undefined exports.
      "outputs": ["dist-es/**"],
      "dependsOn": ["prebuild", "^build:types"],
    },
    "build:es:cjs": {
      "outputs": ["dist-cjs/**", "dist-es/**"],
    },
    "build:types": {
      "outputs": ["dist-types/**"],
      "dependsOn": ["prebuild", "^build:types"],
    },
    "build:types:downlevel": {
      "outputs": ["dist-types/ts3.4/**"],
      // Depends on "build", not "build:types": "build" runs "build:types"
      // internally (via concurrently), so depending on "build:types" here puts
      // two independent producers of dist-types in the graph with no ordering
      // between them. "build:types" starts with "premove dist-types", so it can
      // wipe the directory just as downlevel-dts starts reading it.
      "dependsOn": ["build"],
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false,
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "cache": false,
    },
    "lint": {
      "outputs": [],
    },
    "format": {
      "outputs": [],
    },
    "clean": {
      "cache": false,
    },
    "extract:docs": {
      "dependsOn": ["build"],
      "cache": false,
    },
  },
}
